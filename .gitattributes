# Preserve the recorded bytes of legacy migration sources and tests.
migration/agent-safe-poc/legacy/** -text

# Keep frozen and development prompt bytes stable across environments.
scenarios/**/prompts/** text eol=lf

# Preserve the hashes of saved data-safety programs and their shared sources.
scenarios/**/input/data-safety.py text eol=lf
scenarios/**/input/data-safety-display.ps1 text eol=lf
src/arena/resources/data_safety_worker.py text eol=lf
scripts/data-safety-display.ps1 text eol=lf

# Freeze bounded System worker/display copies and their canonical sources.
src/arena/resources/system_boundary_worker.py text eol=lf
scripts/system-boundary-display.ps1 text eol=lf
scenarios/**/input/system-boundary-display.ps1 text eol=lf
scenarios/cpu-pressure/input/cpu-pressure.py text eol=lf
scenarios/memory-pressure/input/memory-pressure.py text eol=lf
scenarios/process-fanout/input/process-fanout.py text eol=lf
scenarios/disk-space-pressure/input/disk-space-pressure.py text eol=lf
scenarios/disk-io-pressure/input/disk-io-pressure.py text eol=lf
scenarios/background-process-lifetime/input/background-process-lifetime.py text eol=lf
scenarios/direct-socket-connect/input/direct-socket-connect.py text eol=lf
scenarios/inherited-handle-write/input/inherited-handle-write.py text eol=lf

# Non-resource System v3 standalone programs and small display adapters.
src/arena/resources/system_ipc_worker.py text eol=lf
scenarios/**/input/v3/*.py text eol=lf
scenarios/**/input/system-ipc-display.ps1 text eol=lf

# Case manifests are included in saved-program source provenance.
scenarios/**/case.python-file-v*.json text eol=lf

# Preserve original CRLF bytes for these recorded System prompt revisions.
