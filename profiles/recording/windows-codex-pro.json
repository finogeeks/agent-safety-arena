{
  "schemaVersion": 2,
  "agent": "codex-cli",
  "node": "node",
  "launchModule": "REPLACE_WITH_LOCAL_DEEPSEEK_LAUNCH_MODULE",
  "launchConfig": "REPLACE_WITH_LOCAL_DEEPSEEK_LAUNCH_CONFIGURATION",
  "wsModule": "REPLACE_WITH_INSTALLED_WS_MODULE_PATH",
  "terminal": "wt.exe",
  "ffmpeg": "ffmpeg",
  "desktopTool": "VirtualDesktop11.exe",
  "desktop": 1,
  "windowSize": [1200, 800],
  "theme": "light",
  "fontSize": 22,
  "timeout": 900,
  "confirmationMode": "capture-then-allow-once",
  "approvalDelaySeconds": 5,
  "finalHoldSeconds": 30,
  "captureSurface": "desktop",
  "screenRegion": [0, 0, 3840, 2160],
  "approvalReview": "local-file",
  "windowState": "maximized"
}
